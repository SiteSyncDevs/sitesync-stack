# ---------------------------------------------------------------------------
# Everything under stack/ is what ships to a customer machine, so per-site
# secrets must never be committed from there.
# ---------------------------------------------------------------------------
stack/.env
stack/.env.bak.*
stack/mqtt-users.conf
stack/restored-env-*.txt

# Certificates and the MQTT password/permission files (per site, often secret).
stack/certs/*
!stack/certs/.keep
stack/configuration/mosquitto/config/passwd
stack/configuration/mosquitto/config/acl

# Generated by ./sitesync apply from the .env file.
stack/configuration/mosquitto/conf.d/*
!stack/configuration/mosquitto/conf.d/.keep
stack/configuration/chirpstack/chirpstack.toml
stack/compose/gateways.yml

# Backups and imported device data.
stack/backups/
stack/data/
stack/lorawan-devices/

# Build output from the os-provisioning bundlers, anywhere in the tree.
artifacts/

# Keep the templates and git config visible.
!.gitattributes
!.gitignore
!stack/.env.example
!stack/mqtt-users.conf.example
