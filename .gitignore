# Per-site settings and secrets. Never commit these.
.env
.env.bak.*

# Certificates and MQTT password files (per site, often secret).
certs/*
!certs/.keep
configuration/mosquitto/config/passwd
configuration/mosquitto/config/acl
mqtt-users.conf

# Generated by ./sitesync apply from the .env file.
configuration/mosquitto/conf.d/*
!configuration/mosquitto/conf.d/.keep

# Backups and imported data.
backups/
/data
/lorawan-devices

# Build output from the os-provisioning bundlers, anywhere in the tree.
artifacts/

# Keep the template and the git config visible.
!.gitattributes
!.gitignore
!.env.example
!mqtt-users.conf.example
