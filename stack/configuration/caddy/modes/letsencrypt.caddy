# TLS_MODE=letsencrypt  --  real, trusted HTTPS. Free, renews itself.
#
# This mode fails unless ALL of these are true:
#   - SITE_DOMAIN is a real domain name (not localhost, not an IP address)
#   - that name resolves to this machine from the public internet
#   - ports 80 and 443 reach this machine from the public internet
#   - COMPOSE_FILE includes compose/acme.yml, which publishes those two ports
#   - TLS_EMAIL is filled in
# Run ./sitesync doctor and it will tell you which of these is not met.

# The site is served on WEB_PORT (8080 by default), the same as every other
# mode. Ports 80 and 443 are NOT a second way in for people -- they exist only
# so the ACME server can reach Caddy to issue and renew the certificate, which
# it does every 60 days. Caddy handles those challenges itself; there is no
# site block for them here, and nothing is proxied to ChirpStack from them.
https://{$SITE_DOMAIN}:{$WEB_PORT} {
	tls {$TLS_EMAIL}
	reverse_proxy chirpstack:8080
}

https://{$SITE_DOMAIN}:8090 {
	tls {$TLS_EMAIL}
	reverse_proxy chirpstack-rest-api:8090
}
