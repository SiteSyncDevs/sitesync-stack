# TLS_MODE=off  --  plain HTTP, no encryption.
# Answers on any hostname or IP address, so there is nothing to get wrong.

# The same single address as every other mode, on WEB_PORT (8080 by default);
# only the scheme changes. http://<host>:8080 is exactly what upstream
# chirpstack-docker does, so it behaves the way a tech expects, with no
# redirect and no certificate warning. Ports 80 and 443 are not bound.
:{$WEB_PORT} {
	reverse_proxy chirpstack:8080
}

:8090 {
	reverse_proxy chirpstack-rest-api:8090
}
