# Do not edit this file.
# It loads the mode you chose with TLS_MODE in the .env file. The four modes
# live in configuration/caddy/modes/ and are short enough to read.

{
	admin off

	# When the address is an IP rather than a name, browsers send NO SNI --
	# the TLS spec forbids putting a bare IP there. Without this line Caddy
	# gets an empty ServerName, matches no site, and aborts the handshake:
	# the browser shows ERR_SSL_PROTOCOL_ERROR even though the certificate
	# exists and is perfectly valid. This tells Caddy what to assume when
	# SNI is absent, which is always the address this site is reached at.
	default_sni {$SITE_DOMAIN}

	# This site lives on WEB_PORT and nothing else. Left alone, Caddy would
	# also open port 80 inside the container to redirect http -> https; that
	# port is not published on the host, so nothing would reach it, but a
	# listener nobody can use is just something to explain later. Turning the
	# redirects off keeps 80 free for the one case that needs it -- ACME in
	# TLS_MODE=letsencrypt, which Caddy still serves from here.
	auto_https disable_redirects
}

import /etc/caddy/modes/{$TLS_MODE}.caddy
