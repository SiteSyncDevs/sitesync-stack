# =============================================================================
#  SiteSync ChirpStack  --  deployment settings
# =============================================================================
#
#  This is the ONLY file you need to edit.
#
#  After changing anything here, run:      ./sitesync apply
#  If something looks wrong, run:          ./sitesync doctor
#
#  Lines starting with # are notes and are ignored.
#  Do not put spaces around the = sign.   GOOD: PORT=80    BAD: PORT = 80
#
# =============================================================================


# -----------------------------------------------------------------------------
#  1. WHO IS THIS FOR
# -----------------------------------------------------------------------------

# Short name for this customer. Lowercase letters, numbers and dashes only.
# This names the Docker containers, so it must be different on a machine
# that runs more than one of these stacks.
CUSTOMER=acme

# Used to label backups and to identify the site in logs. Free text.
SITE_LABEL="Acme Corp - Main Plant"


# -----------------------------------------------------------------------------
#  2. RADIO            <-- the settings you are most likely to change
# -----------------------------------------------------------------------------

# The radio region this site operates in. Pick the one your gateways are
# certified for; it is the name on the gateway's datasheet.
#
#   US915     North America
#   EU868     Europe
#   AU915     Australia
#   AS923     Asia (all four AS923 plans)
#   CN470     China            CN779   China (old 779 MHz plan)
#   EU433     Europe 433 MHz   IN865   India
#   KR920     South Korea      RU864   Russia
#   ISM2400   2.4 GHz
#
# This does NOT decide what the server enables. It is the fence: every sub-band
# in SERVED_REGIONS below has to belong to it, so a typo that would leave
# gateways connected but deaf is caught before anything starts.
RF_REGION=US915

# The sub-bands this site actually serves, and how each one reaches the server.
# One entry per sub-band, separated by spaces:
#
#     SERVED_REGIONS="<sub-band>:<port>"        a gateway bridge on that UDP port
#     SERVED_REGIONS="<sub-band>:forwarder"     no bridge; see below
#
# Every sub-band listed here is enabled in ChirpStack, and nothing else is. A
# region is enabled because something serves it -- never merely because it
# belongs to RF_REGION.
#
# The two forms differ only in how gateway traffic arrives:
#
#   <port>       This machine runs a ChirpStack Gateway Bridge container
#                listening on that UDP port. The gateway sends the plain
#                Semtech UDP packet-forwarder protocol at it. This is the
#                normal case and what almost every gateway ships configured
#                for. 1700/udp is the standard port, so the first entry should
#                normally use it.
#
#   forwarder    The gateway itself runs ChirpStack's MQTT Forwarder and
#                publishes to this site's broker directly, so there is nothing
#                for this machine to listen on and no container is created.
#                The region still has to be enabled, which is what this does.
#                Such a gateway needs an MQTT login: ./sitesync mqtt add
#
# A gateway sending on channels 0-7 needs us915_0. Gateways using channels
# 8-23 need us915_12 as well, on a different port. Run as many as you need.
#
#   SERVED_REGIONS="us915_0:1700"                    one 8-channel sub-band
#   SERVED_REGIONS="us915_0:1700 us915_12:1701"      8-channel and 16-channel
#   SERVED_REGIONS="us915_0:forwarder"               gateways forward their own
#   SERVED_REGIONS="us915_0:1700 us915_1:forwarder"  one of each
#   SERVED_REGIONS="eu868:1700"                      Europe has one plan
#
# Easier than editing this by hand:  ./sitesync region add
# ./sitesync doctor checks the sub-bands belong to RF_REGION and that no two
# bridges share a port.
SERVED_REGIONS="us915_0:1700"


# -----------------------------------------------------------------------------
#  3. HOW PEOPLE REACH THE WEB INTERFACE
# -----------------------------------------------------------------------------

# The address people type in their browser -- EXACTLY as they type it. A DNS
# name (chirpstack.acme.local) or an IP address (192.168.1.50).
#
# This is not a label. The certificate is issued for this exact value, and the
# web server only answers to this exact value. If it does not match what people
# type, they get a refused connection or a certificate warning that never goes
# away.
#
# 'localhost' means ONLY this machine can open the web interface. Use it only
# if nobody connects from anywhere else.
#
# A DNS name is better than an IP, because it survives the address changing.
# Changing this later is safe: edit it, then run ./sitesync apply
SITE_DOMAIN=localhost

# How the web interface is secured.
#
#   self-signed   HTTPS using a certificate this stack creates by itself.
#                 Needs no domain, no internet and no paperwork. The browser
#                 shows a one-time "not private" warning that you click past.
#                 <-- Start here. This is the right answer for most sites.
#
#   off           Plain HTTP, no encryption. Only sensible on a trusted,
#                 physically secured network.
#
#   letsencrypt   Real, trusted HTTPS. Free and renews itself forever.
#                 Requires ALL of the following, or it will fail:
#                   - SITE_DOMAIN is a real domain name (not localhost, not an IP)
#                   - that name resolves to this machine from the public internet
#                   - ports 80 and 443 are reachable from the public internet
#                   - TLS_EMAIL below is filled in
#
#   custom        You already have a certificate. Put these two files in the
#                 certs/ folder next to this file:
#                     certs/cert.pem     the certificate (full chain)
#                     certs/key.pem      the private key
#                 Nothing else to configure.
#
# Changing this is safe and reversible. Edit the word, run ./sitesync apply.
TLS_MODE=self-signed

# Only used when TLS_MODE=letsencrypt. Let's Encrypt emails this address if a
# certificate is about to expire and could not be renewed.
TLS_EMAIL=

# Only used when TLS_MODE=custom. File names inside the certs/ folder.
TLS_CERT_FILE=cert.pem
TLS_KEY_FILE=key.pem


# -----------------------------------------------------------------------------
#  4. PORTS
# -----------------------------------------------------------------------------
# Change these only if something else on the machine already uses the port.
# Note: letsencrypt REQUIRES 80 and 443 here. The other modes do not care.

HTTP_PORT=80              # web interface (redirects to HTTPS unless TLS_MODE=off)
HTTPS_PORT=443            # web interface, encrypted
REST_API_PORT=8090        # REST / Swagger API
# Gateway ports are NOT here -- each gateway bridge carries its own port in
# SERVED_REGIONS above, because a site can have several.
MQTT_PORT=1883            # MQTT, unencrypted
MQTT_TLS_PORT=8883        # MQTT, encrypted (only used when MQTT_TLS is not "off")

# Which network interface to listen on.
#   0.0.0.0     reachable from anywhere the machine is reachable  (normal)
#   127.0.0.1   reachable only from the machine itself            (locked down)
#   10.0.0.5    reachable only on that specific interface
BIND_ADDRESS=0.0.0.0


# -----------------------------------------------------------------------------
#  5. MQTT (how gateways and integrations talk to the stack)
# -----------------------------------------------------------------------------

# Require a username and password to connect to MQTT.
#   true    gateways and integrations must log in     <-- recommended
#   false   anyone who can reach the port can connect
MQTT_AUTH_ENABLED=true

# The MQTT login. Generated by setup.sh; give these to anything that needs to
# connect, such as an external gateway bridge or a customer's own subscriber.
MQTT_USERNAME=chirpstack
MQTT_PASSWORD=

# Encrypt MQTT connections. Separate from TLS_MODE above, because gateways and
# browsers have different needs.
#
#   off           Plain MQTT on MQTT_PORT. Fine when gateways sit on the same
#                 LAN or a VPN as this machine.        <-- the usual answer
#   self-signed   Adds an encrypted listener on MQTT_TLS_PORT using a
#                 certificate this stack creates. Gateways must be told to
#                 trust certs/mqtt-ca.pem, which the stack writes out for you.
#   custom        Encrypted listener using your own files in certs/:
#                     certs/mqtt-cert.pem  certs/mqtt-key.pem  certs/mqtt-ca.pem
#
# The plain MQTT_PORT listener stays on in every mode so existing gateways
# keep working while you migrate them one at a time.
MQTT_TLS=off

# Where ChirpStack and the gateway bridges CONNECT to a broker. Change this one
# line and every component follows -- there are no broker URLs anywhere else.
#
#   tcp://mosquitto:1883        the broker bundled in this stack   (default)
#   ssl://mosquitto:8883        the bundled broker, encrypted
#                               (also set MQTT_TLS above, and MQTT_CA_CERT below)
#   ssl://mqtt.customer.com:8883    a broker the customer already runs
#   ws://  or  wss://           if their broker only speaks WebSockets
#
# Using ssl:// or wss:// against a broker with a self-signed or private
# certificate? Put the CA file in certs/ and name it in MQTT_CA_CERT.
MQTT_BROKER_URL=tcp://mosquitto:1883

# Certificate authority used to verify the broker above. Leave empty for
# tcp://, or when the broker has a certificate from a public authority.
# Otherwise put the file in certs/ and reference it as /certs/<filename>.
MQTT_CA_CERT=


# -----------------------------------------------------------------------------
#  6. SECRETS       generated by setup.sh -- do not share this file
# -----------------------------------------------------------------------------

# Signs login sessions and API tokens. Changing it logs everyone out and
# invalidates every API key. It is not a password anyone types.
CHIRPSTACK_API_SECRET=

# The database password. Changing it after the first start will NOT work on its
# own, because the database was created with the old one. Ask before changing.
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
#  7. OPTIONAL FEATURES
# -----------------------------------------------------------------------------
# Remove a name from this list to switch that feature off, then ./sitesync apply
#   rest-api        the REST / Swagger API on REST_API_PORT
#
# rest-api is REQUIRED on a SiteSync site -- other SiteSync components call it.
# setup.sh always writes it here and never asks. Removing it will start the site
# but break anything that talks to the REST API.
COMPOSE_PROFILES=rest-api

# Docker Compose reads both files: the fixed services, and the gateway bridges
# generated from SERVED_REGIONS. Do not remove the second one.
COMPOSE_FILE=docker-compose.yml:compose/gateways.yml


# -----------------------------------------------------------------------------
#  8. SOFTWARE VERSIONS
# -----------------------------------------------------------------------------
# Pinned so that a site deployed today and one deployed next year are identical.
# Run  ./sitesync update  to move to newer versions in a controlled way.
CHIRPSTACK_VERSION=4
GATEWAY_BRIDGE_VERSION=4
REST_API_VERSION=4
POSTGRES_VERSION=14-alpine
REDIS_VERSION=7-alpine
MOSQUITTO_VERSION=2
CADDY_VERSION=2

# What Docker may do when an image is not already on this machine.
#   missing   fetch it from the internet if it is not here   (default; dev boxes)
#   never     never contact a registry. Fail loudly instead.
#
# An airgap install sets this to "never" for you. Leave it that way: it turns
# "this image was left out of the artifact" into an immediate, obvious error
# rather than a container that hangs trying to reach a registry it cannot see.
PULL_POLICY=missing


# -----------------------------------------------------------------------------
#  9. HOUSEKEEPING
# -----------------------------------------------------------------------------

# Cap on container log files, so a machine left alone for a year does not fill
# its disk. Each service keeps LOG_MAX_FILES files of LOG_MAX_SIZE each.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Where ./sitesync backup writes to, and how many backups to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Machine timezone, used for log timestamps. e.g. America/New_York, UTC
TZ=UTC


# -----------------------------------------------------------------------------
#  Advanced -- you should not normally need to touch anything below here.
# -----------------------------------------------------------------------------

# Docker Compose uses this to name containers and volumes.
COMPOSE_PROJECT_NAME=chirpstack-${CUSTOMER}

# LoRaWAN NetID. 000000 is correct for a private network.
NET_ID=000000

# ChirpStack log detail: error, warn, info, debug, trace
LOG_LEVEL=info
