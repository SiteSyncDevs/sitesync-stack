#!/usr/bin/env bash
# =============================================================================
#  sitesync -- the one command for running this ChirpStack site.
#
#  Usage:   ./sitesync <command>
#  Run     ./sitesync help     to see everything it can do.
# =============================================================================
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"
HERE="$PWD"

# Region vocabulary and the SERVED_REGIONS parser, shared with render.sh and
# doctor.sh so the three can never disagree about what a region is.
. scripts/lib-regions.sh

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
ok()    { printf '  \033[32mOK\033[0m    %s\n' "$*"; }
warn()  { printf '  \033[33mCHECK\033[0m %s\n' "$*"; }
bad()   { printf '  \033[31mPROBLEM\033[0m %s\n' "$*"; }
info()  { printf '%s\n' "$*"; }
die()   { printf '\n\033[31m%s\033[0m\n\n' "$*" >&2; exit 1; }

DC=(docker compose)

require_env() {
  [[ -f .env ]] || die "There is no .env file here yet. Run:  ./setup.sh"
  set -a; . ./.env; set +a
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed on this machine."
  docker info >/dev/null 2>&1 || die "Docker is installed but not running. Start Docker and try again."
  docker compose version >/dev/null 2>&1 || die "This machine has Docker but not the Compose plugin. Install docker-compose-plugin."
}

# The URL a person should type in their browser.
site_url() {
  local scheme=https port="${HTTPS_PORT:-443}"
  if [[ "${TLS_MODE:-self-signed}" == "off" ]]; then scheme=http; port="${HTTP_PORT:-80}"; fi
  if [[ ( "$scheme" == "https" && "$port" == "443" ) || ( "$scheme" == "http" && "$port" == "80" ) ]]; then
    echo "$scheme://${SITE_DOMAIN:-localhost}"
  else
    echo "$scheme://${SITE_DOMAIN:-localhost}:$port"
  fi
}

# -----------------------------------------------------------------------------
cmd_help() {
  cat <<'TXT'

  sitesync -- run and change this ChirpStack site

  EVERYDAY
    ./sitesync status        Is everything running? Where do I point my browser?
    ./sitesync apply         I changed .env -- make it take effect.
    ./sitesync logs [name]   Show what a service is saying. Ctrl-C to stop.
    ./sitesync doctor        Check the settings and tell me what is wrong.

  STARTING AND STOPPING
    ./sitesync start         Start the site.
    ./sitesync stop          Stop the site. Data is kept.
    ./sitesync restart       Stop then start.

  RADIO REGIONS  (which sub-bands this site serves)
    ./sitesync region list           What is served, and how gateways reach us.
    ./sitesync region add            Serve another sub-band. Asks what it needs.
    ./sitesync region remove NAME    Stop serving one. Asks first.

  LOOKING AFTER IT
    ./sitesync backup        Save the database and settings into backups/
    ./sitesync restore FILE  Put a backup back. Asks before overwriting.
    ./sitesync update        Move to newer software, safely, with a backup first.
    ./sitesync pin           Lock the exact versions now running, for repeat installs.

  MQTT USERS  (dashboards, historians, gateways with their own bridge)
    ./sitesync mqtt list             Who can connect, and what they may do.
    ./sitesync mqtt add NAME ROLE    Add someone. Shows the password once.
    ./sitesync mqtt reset NAME       They lost the password. Gives a new one.
    ./sitesync mqtt remove NAME      Stop them connecting.
    ./sitesync mqtt roles            What the roles mean.
    ./sitesync mqtt show NAME        Connection details to paste into a ticket.

  HANDING DETAILS TO OTHERS
    ./sitesync mqtt-info     Print ChirpStack's own MQTT settings.
    ./sitesync ca            Save the self-signed certificate so browsers trust it.

TXT
}

# -----------------------------------------------------------------------------
# Turn the .env settings into the small generated config files that Mosquitto
# reads. Safe to run any number of times.
cmd_render() {
  require_env
  bash scripts/render.sh
}

# Services that read their configuration from a bind-mounted file will NOT be
# recreated by "compose up -d" when only that file changed -- compose compares
# the service definition, not the contents of mounted files. Without this, an
# edit to the Caddyfile or a regenerated MQTT password file simply never takes
# effect, and the site keeps running the configuration it started with.
reload_mounted_config() {
  local running
  running="$("${DC[@]}" ps --services --status running 2>/dev/null || true)"

  if grep -qx caddy <<<"$running"; then
    local err
    # Check the configuration BEFORE touching the running server. This needs no
    # admin API, so it works with "admin off" -- which is set deliberately, and
    # is also why "caddy reload" cannot be used here: reload posts to the admin
    # API on :2019 and that endpoint is switched off.
    if ! err="$("${DC[@]}" exec -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1)"; then
      bad "the web server configuration is not valid, so nothing was changed:"
      printf '%s\n' "$err" | grep -vE '"level":"(info|warn)"' | sed 's/^/        /'
      info "        The site is still up on the previous settings."
      info "        Fix configuration/caddy/ and re-run ./sitesync apply"
      return 1
    fi
    # Known-good, so a restart is safe. It costs about a second of downtime on
    # the web interface and nothing else; no other service is touched.
    if "${DC[@]}" restart caddy >/dev/null 2>&1; then
      ok "web server restarted with the new configuration"
    else
      bad "the web server would not restart. See why with:  ./sitesync logs caddy"
      return 1
    fi
  fi

  if grep -qx mosquitto <<<"$running"; then
    "${DC[@]}" kill -s HUP mosquitto >/dev/null 2>&1 \
      && ok "MQTT broker reloaded its users and permissions" \
      || warn "could not signal the MQTT broker; run ./sitesync restart if MQTT settings changed"
  fi
}

cmd_start() {
  require_docker; require_env; cmd_render
  bold "Starting ${SITE_LABEL:-this site}..."
  "${DC[@]}" up -d
  # Harmless on a cold start; essential when the containers were already up.
  reload_mounted_config || true
  echo
  cmd_status
}

cmd_stop() {
  require_docker; require_env
  "${DC[@]}" down
  info "Stopped. Nothing was deleted -- ./sitesync start brings it back."
}

cmd_restart() { cmd_stop; cmd_start; }

cmd_apply() {
  require_docker; require_env
  bold "Checking your settings first..."
  if ! cmd_doctor --quiet-on-success; then
    die "Not applying anything until the problems above are fixed."
  fi
  cmd_render
  bold "Applying changes..."
  # --remove-orphans cleans up services you switched off in COMPOSE_PROFILES.
  "${DC[@]}" up -d --remove-orphans
  reload_mounted_config || true
  echo
  cmd_status
}

cmd_status() {
  require_docker; require_env
  bold "${SITE_LABEL:-ChirpStack site}  (${RF_REGION:-?})"
  "${DC[@]}" ps --format 'table {{.Service}}\t{{.Status}}' || true
  echo
  info "Web interface:  $(site_url)"
  if [[ "${TLS_MODE:-}" == "self-signed" ]]; then
    info "                (your browser will warn once about the certificate -- that is expected)"
  fi
  case ",${COMPOSE_PROFILES:-}," in *,rest-api,*)
    local s=https p="${REST_API_PORT:-8090}"
    [[ "${TLS_MODE:-}" == "off" ]] && s=http
    info "REST API:       $s://${SITE_DOMAIN:-localhost}:$p" ;;
  esac
  echo
  served_load
  if [[ -n "$SERVED_VALUE" ]] && served_parse "$SERVED_VALUE" SERVED_REGIONS; then
    info "Regions served:"
    local id
    for id in "${SERVED_IDS[@]}"; do
      if [[ "${SERVED_HOW[$id]}" == forwarder ]]; then
        info "  $(printf '%-11s' "$id") gateways publish over MQTT themselves"
      else
        info "  $(printf '%-11s' "$id") UDP port ${SERVED_HOW[$id]} on ${SITE_DOMAIN:-this host}"
      fi
    done
  else
    info "No regions are served, so no gateway can connect."
    info "Add one with:  ./sitesync region add"
  fi
}

cmd_logs() {
  require_docker; require_env
  if [[ $# -gt 0 ]]; then "${DC[@]}" logs -f --tail=200 "$1"
  else "${DC[@]}" logs -f --tail=100; fi
}

cmd_mqtt_info() {
  require_env
  bold "MQTT connection details for ${SITE_LABEL:-this site}"
  echo
  info "  Host          ${SITE_DOMAIN:-this host}"
  info "  Port          ${MQTT_PORT:-1883}   (plain)"
  if [[ "${MQTT_TLS:-off}" != "off" ]]; then
    info "  Port          ${MQTT_TLS_PORT:-8883}   (encrypted)"
    info "  CA to trust   certs/mqtt-ca.pem  -- copy this onto each gateway"
  fi
  if [[ "${MQTT_AUTH_ENABLED:-true}" == "true" ]]; then
    info "  Username      ${MQTT_USERNAME:-chirpstack}"
    info "  Password      ${MQTT_PASSWORD:-<not set -- run ./setup.sh>}"
  else
    info "  Login         not required"
  fi
  info "  Topic prefix  one per sub-band -- see SERVED_REGIONS in .env"
  echo
  warn "This output contains a password. Do not paste it into a ticket or chat."
}

cmd_ca() {
  require_docker; require_env
  [[ "${TLS_MODE:-}" == "self-signed" ]] || die "This only applies when TLS_MODE=self-signed."
  mkdir -p certs
  docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt certs/sitesync-root-ca.crt \
    || die "Could not read the certificate. Is the site running? Try ./sitesync start"
  bold "Saved to certs/sitesync-root-ca.crt"
  info "Install this file on any computer that should not see the browser warning:"
  info "  Windows  double-click, Install Certificate, Local Machine, Trusted Root Certification Authorities"
  info "  macOS    double-click, then set it to Always Trust in Keychain Access"
}

# -----------------------------------------------------------------------------
# Regions. Adding one is the single most common change to a live site -- a
# customer buys gateways on a second sub-band -- and doing it by hand means
# editing .env, knowing the sub-band spelling, and picking a free port. This
# does all three, then applies.

# Rewrite SERVED_REGIONS in .env, keeping every comment around it.
set_served() {  # set_served "<value>"
  awk -v v="$1" '
    index($0, "SERVED_REGIONS=") == 1 { print "SERVED_REGIONS=\"" v "\""; found=1; next }
    { print }
    END { if (!found) print "SERVED_REGIONS=\"" v "\"" }
  ' .env > .env.tmp && mv .env.tmp .env
  chmod 600 .env 2>/dev/null || true
}

# The current list as a flat string, in list order.
served_string() {
  local id out=""
  for id in "${SERVED_IDS[@]+"${SERVED_IDS[@]}"}"; do
    out+="${out:+ }$id:${SERVED_HOW[$id]}"
  done
  printf '%s' "$out"
}

# Load and parse, dying with the parser's own wording if .env is malformed.
load_served() {
  served_load
  served_parse "$SERVED_VALUE" SERVED_REGIONS || die "$SERVED_ERROR"
}

cmd_region_list() {
  require_env; load_served
  bold "Regions served by ${SITE_LABEL:-this site}  (${RF_REGION:-?})"
  echo
  if (( ${#SERVED_IDS[@]} == 0 )); then
    info "  none -- no gateway can connect. Add one with:  ./sitesync region add"
    return 0
  fi
  local id
  for id in "${SERVED_IDS[@]}"; do
    if [[ "${SERVED_HOW[$id]}" == forwarder ]]; then
      printf '  %-11s  %-18s %s\n' "$id" "MQTT Forwarder" "$(region_description "$id")"
    else
      printf '  %-11s  %-18s %s\n' "$id" "UDP ${SERVED_HOW[$id]}" "$(region_description "$id")"
    fi
  done
  echo
  local avail=() i
  mapfile -t i < <(region_ids_for "${RF_REGION:-}")
  for id in "${i[@]+"${i[@]}"}"; do
    [[ -n "${SERVED_HOW[$id]:-}" ]] || avail+=("$id")
  done
  if (( ${#avail[@]} )); then
    info "Also available in ${RF_REGION}: ${avail[*]}"
    info "Add one with:  ./sitesync region add"
  fi
}

cmd_region_add() {
  require_env; load_served
  local sub="${1:-}" how="${2:-}" i avail=() id

  mapfile -t i < <(region_ids_for "${RF_REGION:-}")
  (( ${#i[@]} )) || die "RF_REGION is '${RF_REGION:-}', which this stack does not know."
  for id in "${i[@]}"; do
    [[ -n "${SERVED_HOW[$id]:-}" ]] || avail+=("$id")
  done

  if [[ -z "$sub" ]]; then
    (( ${#avail[@]} )) || die "Every sub-band of $RF_REGION is already served. Nothing to add."
    bold "Add a region to ${SITE_LABEL:-this site}"
    echo
    info "Sub-bands of $RF_REGION not yet served:"
    for id in "${avail[@]}"; do
      printf '  %-11s %s\n' "$id" "$(region_description "$id")"
    done
    echo
    read -r -p "Which sub-band [${avail[0]}]: " sub </dev/tty \
      || die "This needs a terminal. Pass the sub-band as an argument instead."
    sub="${sub:-${avail[0]}}"
  fi

  # Validate before asking anything else, so a typo costs one question.
  [[ -z "${SERVED_HOW[$sub]:-}" ]] || die "$sub is already served (${SERVED_HOW[$sub]}).
To change how, remove it first:  ./sitesync region remove $sub"
  local rf; rf="$(rf_of_region_id "$sub")"
  [[ -n "$rf" ]] || die "'$sub' is not a frequency plan this stack knows about.
Available in $RF_REGION: ${avail[*]}"
  [[ "$rf" == "$RF_REGION" ]] || die "'$sub' belongs to $rf, but this site runs $RF_REGION.
Gateways on that plan would connect and their uplinks would go nowhere."

  if [[ -z "$how" ]]; then
    local suggested; suggested="$(served_next_port)"
    echo
    info "How will gateways on $sub reach this site?"
    info "  1) a gateway bridge here -- the gateway sends Semtech UDP at us  (usual)"
    info "  2) the gateway runs ChirpStack's MQTT Forwarder and publishes itself"
    echo
    local pick; read -r -p "Choose [1]: " pick </dev/tty || pick=1
    if [[ "${pick:-1}" == 2 ]]; then
      how=forwarder
    else
      read -r -p "  UDP port [$suggested]: " how </dev/tty || how="$suggested"
      how="${how:-$suggested}"
    fi
  fi

  local new; new="$(served_string)"
  new="${new:+$new }$sub:$how"
  # Parse the whole prospective list rather than trusting the new entry alone:
  # that is what catches a port already taken by another bridge.
  served_parse "$new" SERVED_REGIONS || die "$SERVED_ERROR"

  set_served "$new"
  echo
  if [[ "$how" == forwarder ]]; then
    ok "added $sub, served by the gateway's own MQTT Forwarder"
    info "Those gateways need an MQTT login. Create one with:"
    info "    ./sitesync mqtt add <name> gateway"
    info "and point the forwarder's topic prefix at:  $sub"
  else
    ok "added $sub on UDP port $how"
    info "Point the gateways' packet forwarder at ${SITE_DOMAIN:-this host}:$how"
  fi
  echo
  cmd_apply
}

cmd_region_remove() {
  require_env; load_served
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "Which one? Run  ./sitesync region list  to see them."
  [[ -n "${SERVED_HOW[$sub]:-}" ]] || die "$sub is not in SERVED_REGIONS. Nothing to remove."

  if (( ${#SERVED_IDS[@]} == 1 )); then
    warn "$sub is the only region this site serves."
    info "  Removing it leaves the site running but unable to accept any gateway,"
    info "  and ./sitesync apply will refuse until you add one back."
  else
    warn "Gateways transmitting on $sub will stop reaching this site."
  fi
  if [[ "${SERVED_HOW[$sub]}" != forwarder ]]; then
    info "  The bridge container on UDP ${SERVED_HOW[$sub]} is removed."
  fi
  info "  Devices, applications and past data are NOT touched."
  echo
  local reply
  read -r -p "Remove $sub? [y/N]: " reply </dev/tty \
    || die "This needs a terminal to confirm on."
  [[ "${reply,,}" == y* ]] || { info "Left alone."; return 0; }

  local id new=""
  for id in "${SERVED_IDS[@]}"; do
    [[ "$id" == "$sub" ]] && continue
    new+="${new:+ }$id:${SERVED_HOW[$id]}"
  done
  set_served "$new"
  ok "removed $sub"
  echo
  if [[ -z "$new" ]]; then
    warn "SERVED_REGIONS is now empty, so apply would refuse to run."
    info "Add a region before starting the site:  ./sitesync region add"
    return 0
  fi
  cmd_apply
}

cmd_region() {
  case "${1:-list}" in
    list|ls|"")      shift || true; cmd_region_list ;;
    add|new)         shift; cmd_region_add "$@" ;;
    remove|rm|del)   shift; cmd_region_remove "$@" ;;
    *) die "Unknown: ./sitesync region $1
Try:  ./sitesync region list | add | remove" ;;
  esac
}

cmd_backup()  { require_docker; require_env; bash scripts/backup.sh; }
cmd_restore() { require_docker; require_env; bash scripts/restore.sh "$@"; }
cmd_update()  { require_docker; require_env; bash scripts/update.sh; }
cmd_pin()     { require_docker; require_env; bash scripts/pin.sh; }
cmd_doctor()  { require_env; bash scripts/doctor.sh "$@"; }
cmd_mqtt()    { require_docker; require_env; bash scripts/mqtt.sh "$@"; }

# -----------------------------------------------------------------------------
case "${1:-help}" in
  help|-h|--help) cmd_help ;;
  start|up)       cmd_start ;;
  stop|down)      cmd_stop ;;
  restart)        cmd_restart ;;
  apply)          cmd_apply ;;
  status|ps)      cmd_status ;;
  logs)           shift; cmd_logs "$@" ;;
  doctor|check)   shift || true; cmd_doctor "$@" ;;
  render)         cmd_render ;;
  backup)         cmd_backup ;;
  restore)        shift; cmd_restore "$@" ;;
  update)         cmd_update ;;
  pin)            cmd_pin ;;
  region|regions) shift || true; cmd_region "$@" ;;
  mqtt)           shift; cmd_mqtt "$@" ;;
  mqtt-info)      cmd_mqtt_info ;;
  ca)             cmd_ca ;;
  *) die "I do not know the command '$1'. Run ./sitesync help" ;;
esac
